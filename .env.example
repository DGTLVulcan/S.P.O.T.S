# Copy to .env for local development. .env is gitignored, so this stays a
# machine-local override and never reaches the Pi or the repo.
#
# These layer on top of config.yaml -- anything not set here keeps whatever
# the YAML says. A variable already exported in your shell beats this file.
# Values set here are NOT written back when settings are saved from the web
# UI, so a dev override can't quietly become the committed configuration.

# Run against the fabricated target instead of a real camera, so the app
# works on a laptop with no hardware attached.
SPOTS_CAMERA_SOURCE=synthetic

# Point at a real Z CAM instead. Leave blank to auto-discover it on the
# Ethernet link (what the Pi does in the field).
#SPOTS_CAMERA_SOURCE=zcam
#SPOTS_CAMERA_IP=192.168.10.192

# Keep dev runs off the port the real service uses, and out of its database.
SPOTS_WEB_PORT=8080
SPOTS_DB_PATH=spots.db
SPOTS_SNAPSHOT_DIR=snapshots

# Stream tuning. A laptop can afford a sharper picture than the Pi's own
# WiFi can carry; 0 sends frames at native resolution.
#SPOTS_WEB_STREAM_MAX_WIDTH=0
#SPOTS_WEB_STREAM_FPS=15
#SPOTS_WEB_STREAM_QUALITY=85

# Detection sample rate, if you want a faster loop while testing.
#SPOTS_DETECTION_SAMPLE_FPS=3

# Load a different config file entirely.
#SPOTS_CONFIG=config.dev.yaml
